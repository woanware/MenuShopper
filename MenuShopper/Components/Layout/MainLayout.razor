@inherits LayoutComponentBase
@inject MenuShopper.Services.DataService DataService
@inject MenuShopper.Services.WindowsAutoStartService AutoStartService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudThemeProvider IsDarkMode="true" Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="ms-shell">
    <MudAppBar Color="Color.Default" Elevation="0" Class="ms-appbar">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ms-brand">
            <MudAvatar Size="Size.Small" Class="ms-brand-mark">M</MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1" Class="ms-brand-title">MenuShopper</MudText>
                <MudText Typo="Typo.caption" Class="ms-brand-subtitle">Meals, menus, lists</MudText>
            </MudStack>
        </MudStack>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Mini" Elevation="0" Class="ms-drawer">
        <MudNavMenu Class="ms-nav">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/meals" Icon="@Icons.Material.Filled.Restaurant">Meals</MudNavLink>
            <MudNavLink Href="/menus" Icon="@Icons.Material.Filled.EventNote">Menus</MudNavLink>
            <MudNavLink Href="/shopping-lists" Icon="@Icons.Material.Filled.ShoppingCart">Shopping Lists</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="ms-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="ms-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#9BB7FF",
            PrimaryDarken = "#7897E8",
            PrimaryLighten = "#B8C9FF",
            Secondary = "#A8B0BD",
            Background = "#0A0C0F",
            Surface = "#15181D",
            AppbarBackground = "#101318",
            AppbarText = "#F3F5F7",
            DrawerBackground = "#0D1014",
            DrawerText = "#C4CAD3",
            DrawerIcon = "#8C95A3",
            TextPrimary = "#F3F5F7",
            TextSecondary = "#B5BDC8",
            ActionDefault = "#B5BDC8",
            LinesDefault = "#2A3038",
            Success = "#7DD3A8",
            Warning = "#E4B45F",
            Error = "#F08A9B"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Segoe UI Variable", "Segoe UI", "system-ui", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
                FontSize = "0.95rem",
                LineHeight = "1.5",
                LetterSpacing = "-0.01em"
            },
            H4 = new H4Typography
            {
                FontWeight = "760",
                FontSize = "2rem",
                LineHeight = "1.12",
                LetterSpacing = "-0.035em"
            },
            H5 = new H5Typography
            {
                FontWeight = "720",
                FontSize = "1.45rem",
                LineHeight = "1.18",
                LetterSpacing = "-0.025em"
            },
            Subtitle1 = new Subtitle1Typography
            {
                FontWeight = "680",
                LetterSpacing = "-0.015em"
            },
            Subtitle2 = new Subtitle2Typography
            {
                FontWeight = "680",
                LetterSpacing = "-0.01em"
            },
            Button = new ButtonTypography
            {
                FontWeight = "700",
                TextTransform = "none",
                LetterSpacing = "-0.01em"
            }
        }
    };

    private bool _checkedAutoStartPrompt;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checkedAutoStartPrompt)
            return;

        _checkedAutoStartPrompt = true;

        if (!OperatingSystem.IsWindows())
            return;

        MenuShopper.Models.UserSettings settings;
        try
        {
            settings = await DataService.LoadUserSettingsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't load user settings: {ex.Message}", Severity.Warning);
            return;
        }

        if (settings.HasSeenAutoStartPrompt)
            return;

        var alreadyEnabled = false;
        try
        {
            alreadyEnabled = AutoStartService.IsEnabled();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't check Windows startup: {ex.Message}", Severity.Warning);
        }

        if (alreadyEnabled)
        {
            settings.HasSeenAutoStartPrompt = true;
            try
            {
                await DataService.SaveUserSettingsAsync(settings);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Couldn't save user settings: {ex.Message}", Severity.Warning);
            }

            return;
        }

        var options = new MessageBoxOptions
        {
            Title = "Start with Windows?",
            Message = "Start MenuShopper automatically when you sign into Windows?",
            YesText = "Enable",
            CancelText = "No thanks"
        };

        var result = await DialogService.ShowMessageBoxAsync(options, new DialogOptions { CloseOnEscapeKey = true });

        if (result == true)
        {
            try
            {
                AutoStartService.Enable();
                Snackbar.Add("MenuShopper will start with Windows.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Couldn't enable Windows startup: {ex.Message}", Severity.Error);
            }
        }

        settings.HasSeenAutoStartPrompt = true;
        try
        {
            await DataService.SaveUserSettingsAsync(settings);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't save user settings: {ex.Message}", Severity.Warning);
        }
    }
}
