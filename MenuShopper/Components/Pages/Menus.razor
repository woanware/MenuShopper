@page "/menus"
@inject MenuShopper.Services.DataService DataService
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Menus</PageTitle>

<MudPaper Class="ms-page-header pa-5 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="ms-toolbar">
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5" Class="ms-page-title">Menus</MudText>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">@_menus.Count total</MudChip>
            </MudStack>
            <MudText Typo="Typo.body2" Class="ms-page-copy">Plan a date, pick meals, and generate the list in one pass.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/menus/new">
            New menu
        </MudButton>
    </MudStack>
</MudPaper>

@if (_menus.Count == 0)
{
    <MudPaper Class="ms-empty-state pa-6">
        <MudAvatar Class="ms-empty-icon" Size="Size.Large">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" />
        </MudAvatar>
        <MudText Typo="Typo.h5" Class="ms-page-title">No menus planned yet</MudText>
        <MudText Typo="Typo.body2" Class="ms-page-copy">Create a menu to lock in meals and generate a shopping list automatically.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/menus/new">
            New menu
        </MudButton>
    </MudPaper>
}
else
{
    <MudTable Items="_menus" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Meals</MudTh>
            <MudTh>Items</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.DisplayDate</MudTd>
            <MudTd DataLabel="Meals">@context.MealCountText</MudTd>
            <MudTd DataLabel="Items">@context.ItemCountText</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Href="@($"/menus/edit/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Info" Href="@($"/menus/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Href="@($"/shopping-lists/{context.Id}")" />            
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteMenuAsync(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<MenuShopper.Models.Menu> _menus = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await DataService.LoadMealsAsync();
        await DataService.LoadMenusAsync();
        _menus = DataService.GetMenus().ToList();
    }

    private async Task DeleteMenuAsync(MenuShopper.Models.Menu menu)
    {
        if (!await ConfirmDeleteAsync("Delete menu", $"Delete menu starting {menu.DisplayDate}?"))
            return;

        try
        {
            await DataService.DeleteMenuAsync(menu);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowErrorAsync("Delete failed", ex.Message);
        }
    }

    private async Task ShowErrorAsync(string title, string message)
    {
        var options = new MessageBoxOptions
        {
            Title = title,
            Message = message,
            YesText = "OK"
        };

        await DialogService.ShowMessageBoxAsync(options, new DialogOptions { CloseOnEscapeKey = true });
    }

    private async Task<bool> ConfirmDeleteAsync(string title, string message)
    {
        var options = new MessageBoxOptions
        {
            Title = title,
            Message = message,
            YesText = "Delete",
            CancelText = "Cancel"
        };

        var result = await DialogService.ShowMessageBoxAsync(options, new DialogOptions { CloseOnEscapeKey = true });
        return result == true;
    }
}
