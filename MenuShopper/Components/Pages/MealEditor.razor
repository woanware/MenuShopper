@page "/meals/new"
@page "/meals/edit/{MealId:guid}"
@page "/meals/clone/{CloneId:guid}"
@inject MenuShopper.Services.DataService DataService
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>@_title</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.h5">@_title</MudText>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">@(_isNew ? "New" : "Editing")</MudChip>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (!_isNew)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error" OnClick="Delete" />
            }
            <MudIconButton Icon="@Icons.Material.Filled.Check" Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" />
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_meal.Name" Label="Meal Name" Required="true" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Category" @bind-Value="_meal.Category" Dense="true">
                @foreach (var category in _categories)
                {
                    <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCheckBox T="bool" @bind-Value="_meal.IsDairy" Label="Contains Dairy" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCheckBox T="bool" @bind-Value="_meal.IsFavourite" Label="Favourite" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.subtitle2" Class="mb-2">Ingredients</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.subtitle1">Ingredient Extraction</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh" Variant="Variant.Filled" Color="Color.Primary"
                           aria-label="Extract ingredients from recipe text"
                           Disabled="_isExtractingIngredients" OnClick="ExtractIngredientsFromRecipeAsync" />
        </MudStack>

        <MudTextField @bind-Value="_recipeText"
                      Label="Paste recipe text"
                      Lines="6"
                      AutoGrow="true"
                      Immediate="true"
                      TextUpdateSuppression="false"
                      Class="mt-2" />

        @if (_isExtractingIngredients)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
        @if (!string.IsNullOrWhiteSpace(_recipeIngredientsMessage))
        {
            <MudAlert Severity="Severity.Success" Class="mt-2">@_recipeIngredientsMessage</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_recipeIngredientsError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_recipeIngredientsError</MudAlert>
        }
    </MudPaper>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudTextField @bind-Value="_newIngredient"
                      Placeholder="Add ingredient"
                      Immediate="true"
                      TextUpdateSuppression="false"
                      OnKeyDown="HandleIngredientKeyDown" />
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" OnClick="AddIngredient" />
    </MudStack>

    <MudTable T="IngredientRow" Items="@GetIngredientRows()" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Ingredient</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
         <RowTemplate>
             <MudTd DataLabel="Ingredient" Style="width: 100%">
                 <MudTextField Value="@context.Value"
                               ValueChanged="(string value) => UpdateIngredient(context.Index, value)"
                               TextUpdateSuppression="false"
                               Margin="Margin.Dense"
                               @key="context.Index" />
             </MudTd>
             <MudTd>
                 <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => RemoveIngredientAtAsync(context.Index)" />
             </MudTd>
         </RowTemplate>
 </MudTable>

</MudPaper>

@code {
    [Parameter] public Guid? MealId { get; set; }
    [Parameter] public Guid? CloneId { get; set; }

    private MenuShopper.Models.Meal _meal = new();
    private string _newIngredient = string.Empty;
    private string _recipeText = string.Empty;
    private bool _isExtractingIngredients;
    private string _recipeIngredientsError = string.Empty;
    private string _recipeIngredientsMessage = string.Empty;
    private string _title = "Add Meal";
    private bool _isNew = true;
    private List<string> _categories = [];
    private const int MaxExtractedIngredients = 40;
    private const string RecipeIngredientsPrompt =
        "You are extracting ingredients from a recipe for a meal planner." +
        "\nReturn ONLY ingredient names, one per line." +
        "\nCapitalize the first letter of each ingredient line (e.g., 'Onion', 'Olive oil')." +
        "\nDo not include quantities, units, headings, numbering, bullets, or any extra text." +
        "\nDo not repeat ingredients." +
        "\n\nRecipe text:";

    protected override async Task OnInitializedAsync()
    {
        await DataService.LoadMealsAsync();
        _categories = (await DataService.LoadCategoriesAsync())
            .Select(category => category?.Trim() ?? string.Empty)
            .Where(category => !string.IsNullOrWhiteSpace(category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (_categories.Count == 0)
            _categories = ["Other"];
        if (CloneId.HasValue)
        {
            var source = DataService.FindMealById(CloneId.Value);
            if (source != null)
            {
                _meal = new MenuShopper.Models.Meal
                {
                    Ingredients = source.Ingredients.ToList()
                };
            }
            _title = "Clone Meal";
        }
        else if (MealId.HasValue)
        {
            var existing = DataService.FindMealById(MealId.Value);
            if (existing != null)
            {
                _meal = existing;
                _isNew = false;
                _title = "Edit Meal";
            }
        }
    }

    private void AddIngredient()
    {
        var text = _newIngredient.Trim();
        if (string.IsNullOrWhiteSpace(text))
            return;

        if (_meal.Ingredients.Any(i => string.Equals(i, text, StringComparison.OrdinalIgnoreCase)))
            return;

        _meal.Ingredients.Add(text);
        _newIngredient = string.Empty;
    }

    private async Task HandleIngredientKeyDown(KeyboardEventArgs args)
    {
        if ((args.Key == "Enter" || args.Key == "NumpadEnter") && !args.Repeat)
        {
            AddIngredient();
            await Task.Delay(100);
            _newIngredient = string.Empty;
            StateHasChanged();
        }
    }

    private List<IngredientRow> GetIngredientRows()
    {
        return _meal.Ingredients.Select((value, index) => new IngredientRow(index, value)).ToList();
    }

    private void UpdateIngredient(int index, string value)
    {
        if (index < 0 || index >= _meal.Ingredients.Count)
            return;

        _meal.Ingredients[index] = value;
    }

    private async Task RemoveIngredientAtAsync(int index)
    {
        if (index < 0 || index >= _meal.Ingredients.Count)
            return;

        var ingredient = _meal.Ingredients[index];
        if (!await ConfirmDeleteAsync("Delete ingredient", $"Delete '{ingredient}' from this meal?"))
            return;

        _meal.Ingredients.RemoveAt(index);
    }

    private async Task ExtractIngredientsFromRecipeAsync()
    {
        if (_isExtractingIngredients)
            return;

        var recipeText = _recipeText.Trim();
        if (string.IsNullOrWhiteSpace(recipeText))
        {
            _recipeIngredientsMessage = string.Empty;
            _recipeIngredientsError = "Paste some recipe text first.";
            return;
        }

        _isExtractingIngredients = true;
        _recipeIngredientsError = string.Empty;
        _recipeIngredientsMessage = string.Empty;

        try
        {
            var response = await DataService.SendCopilotPromptAsync(
                $"{RecipeIngredientsPrompt}\n{recipeText}",
                "gpt-5.2",
                "high",
                TimeSpan.FromMinutes(3),
                CancellationToken.None
            );

            if (string.IsNullOrWhiteSpace(response))
            {
                _recipeIngredientsError = "No response received.";
                return;
            }

            var extracted = ParseIngredientsOutput(response);
            if (extracted.Count == 0)
            {
                _recipeIngredientsError = "No ingredients could be extracted. Try again or paste more of the ingredients section.";
                return;
            }

            var added = AddIngredients(extracted);
            if (added == 0)
            {
                _recipeIngredientsError = "No new ingredients were added (they may already exist).";
                return;
            }

            _recipeIngredientsMessage = $"Added {added} ingredient(s). Please review and edit as needed.";
            _recipeText = string.Empty;
        }
        catch (Exception ex)
        {
            _recipeIngredientsError = ex.Message;
        }
        finally
        {
            _isExtractingIngredients = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private int AddIngredients(IEnumerable<string> ingredients)
    {
        var existing = _meal.Ingredients.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var added = 0;

        foreach (var ingredient in ingredients)
        {
            var text = ingredient.Trim();
            if (string.IsNullOrWhiteSpace(text))
                continue;

            if (!existing.Add(text))
                continue;

            _meal.Ingredients.Add(text);
            added++;
        }

        return added;
    }

    private List<string> ParseIngredientsOutput(string output)
    {
        var normalized = output
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(NormalizeIngredientLine)
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(MaxExtractedIngredients)
            .ToList();

        return normalized;
    }

    private static string NormalizeIngredientLine(string line)
    {
        var text = line.Trim();
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        if (text.EndsWith(':'))
            return string.Empty;

        // Strip common bullet prefixes.
        text = text.TrimStart('-', '*', '\u2022', '\u00B7', '\u2013').Trim();

        // Strip common numbering prefixes (e.g. "1.", "2)", "3 -").
        var idx = 0;
        while (idx < text.Length && char.IsDigit(text[idx]))
            idx++;

        if (idx > 0 && idx < text.Length)
        {
            while (idx < text.Length && (text[idx] == '.' || text[idx] == ')' || text[idx] == '-' || char.IsWhiteSpace(text[idx])))
                idx++;

            text = text[idx..].Trim();
        }

        text = text.Trim().TrimEnd(',', ';', '.');
        if (text.Length == 0)
            return string.Empty;

        if (char.IsLetter(text[0]) && char.IsLower(text[0]))
            return char.ToUpperInvariant(text[0]) + text[1..];

        return text;
    }

    private async Task Save()
    {
        _meal.Name = _meal.Name.Trim();
        _meal.Category = string.IsNullOrWhiteSpace(_meal.Category) ? "Other" : _meal.Category.Trim();
        _meal.Ingredients = _meal.Ingredients
            .Select(i => i.Trim())
            .Where(i => !string.IsNullOrWhiteSpace(i))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(i => i)
            .ToList();

        if (string.IsNullOrWhiteSpace(_meal.Name))
            return;

        if (_isNew)
            await DataService.AddMealAsync(_meal);
        else
            await DataService.UpdateMealAsync(_meal);

        Nav.NavigateTo("/meals");
    }

    private async Task Delete()
    {
        if (!await ConfirmDeleteAsync("Delete meal", $"Delete '{_meal.Name}'?"))
            return;

        await DataService.DeleteMealAsync(_meal);
        Nav.NavigateTo("/meals");
    }

    private async Task<bool> ConfirmDeleteAsync(string title, string message)
    {
        var options = new MessageBoxOptions
        {
            Title = title,
            Message = message,
            YesText = "Delete",
            CancelText = "Cancel"
        };

        var result = await DialogService.ShowMessageBox(options, new DialogOptions { CloseOnEscapeKey = true });
        return result == true;
    }

    private record IngredientRow(int Index, string Value);
}
