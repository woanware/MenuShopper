@page "/settings"
@inject MenuShopper.Services.DataService DataService
@inject MenuShopper.Services.WindowsAutoStartService AutoStartService
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.h5">Settings</MudText>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">Preferences</MudChip>
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.subtitle2">Data folder</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">@_dataPath</MudText>
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.subtitle2">Startup</MudText>

    @if (!_isWindows)
    {
        <MudText Typo="Typo.body2" Class="mt-1">Startup integration is only available on Windows.</MudText>
    }
    else
    {
        <MudSwitch T="bool"
                   Color="Color.Primary"
                   Label="Start MenuShopper with Windows"
                   @bind-Value="_startWithWindows"
                   @bind-Value:after="OnStartWithWindowsToggled" />

        @if (!string.IsNullOrWhiteSpace(_startupError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_startupError</MudAlert>
        }
    }
</MudPaper>

@code {
    private string _dataPath = string.Empty;
    private readonly bool _isWindows = OperatingSystem.IsWindows();
    private bool _startWithWindows;
    private string? _startupError;

    protected override void OnInitialized()
    {
        _dataPath = DataService.GetDataFolderPath();

        if (_isWindows)
            RefreshStartupState();
    }

    private void RefreshStartupState()
    {
        try
        {
            _startupError = null;
            _startWithWindows = AutoStartService.IsEnabled();
        }
        catch (Exception ex)
        {
            _startupError = ex.Message;
            _startWithWindows = false;
        }
    }

    private Task OnStartWithWindowsToggled()
    {
        try
        {
            _startupError = null;
            if (_startWithWindows)
                AutoStartService.Enable();
            else
                AutoStartService.Disable();

            _startWithWindows = AutoStartService.IsEnabled();
            Snackbar.Add(
                _startWithWindows ? "Enabled Windows startup." : "Disabled Windows startup.",
                Severity.Success
            );
        }
        catch (Exception ex)
        {
            _startupError = ex.Message;
            Snackbar.Add($"Couldn't update Windows startup: {ex.Message}", Severity.Error);
            RefreshStartupState();
        }

        return Task.CompletedTask;
    }
}
