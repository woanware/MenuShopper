@page "/settings"
@inject MenuShopper.Services.DataService DataService
@inject MenuShopper.Services.WindowsAutoStartService AutoStartService
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>

<MudPaper Class="ms-page-header pa-5 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5" Class="ms-page-title">Settings</MudText>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">Preferences</MudChip>
            </MudStack>
            <MudText Typo="Typo.body2" Class="ms-page-copy">Tune startup behavior and how Copilot builds suggestions.</MudText>
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="ms-panel pa-4">
    <MudText Typo="Typo.subtitle2">Data folder</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">@_dataPath</MudText>
</MudPaper>

<MudPaper Class="ms-panel pa-4 mt-4">
    <MudText Typo="Typo.subtitle2">Meal Suggestions</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 mb-2">Choose how many weeks of recent menus to include when building the meal suggestions prompt.</MudText>
    <MudSelect T="int"
               Label="Prompt lookback"
               Dense="true"
               @bind-Value="_mealSuggestionsLookbackWeeks"
               @bind-Value:after="OnMealSuggestionsLookbackWeeksChangedAsync">
        @for (var weeks = MenuShopper.Models.UserSettings.MinMealSuggestionsLookbackWeeks; weeks <= MenuShopper.Models.UserSettings.MaxMealSuggestionsLookbackWeeks; weeks++)
        {
            <MudSelectItem T="int" Value="@weeks">@GetMealSuggestionsLookbackLabel(weeks)</MudSelectItem>
        }
    </MudSelect>

    @if (!string.IsNullOrWhiteSpace(_preferencesError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_preferencesError</MudAlert>
    }
</MudPaper>

<MudPaper Class="ms-panel pa-4 mt-4">
    <MudText Typo="Typo.subtitle2">Startup</MudText>

    @if (!_isWindows)
    {
        <MudText Typo="Typo.body2" Class="mt-1">Startup integration is only available on Windows.</MudText>
    }
    else
    {
        <MudSwitch T="bool"
                   Color="Color.Primary"
                   Label="Start MenuShopper with Windows"
                   @bind-Value="_startWithWindows"
                   @bind-Value:after="OnStartWithWindowsToggled" />

        @if (!string.IsNullOrWhiteSpace(_startupError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_startupError</MudAlert>
        }
    }
</MudPaper>

@code {
    private string _dataPath = string.Empty;
    private readonly bool _isWindows = OperatingSystem.IsWindows();
    private MenuShopper.Models.UserSettings _userSettings = new();
    private int _mealSuggestionsLookbackWeeks = MenuShopper.Models.UserSettings.DefaultMealSuggestionsLookbackWeeks;
    private string? _preferencesError;
    private bool _startWithWindows;
    private string? _startupError;

    protected override async Task OnInitializedAsync()
    {
        _dataPath = DataService.GetDataFolderPath();
        await RefreshUserSettingsAsync();

        if (_isWindows)
            RefreshStartupState();
    }

    private void RefreshStartupState()
    {
        try
        {
            _startupError = null;
            _startWithWindows = AutoStartService.IsEnabled();
        }
        catch (Exception ex)
        {
            _startupError = ex.Message;
            _startWithWindows = false;
        }
    }

    private async Task RefreshUserSettingsAsync()
    {
        try
        {
            _preferencesError = null;
            _userSettings = await DataService.LoadUserSettingsAsync();
            _mealSuggestionsLookbackWeeks = _userSettings.MealSuggestionsLookbackWeeks;
        }
        catch (Exception ex)
        {
            _preferencesError = ex.Message;
            _userSettings = new MenuShopper.Models.UserSettings();
            _mealSuggestionsLookbackWeeks = _userSettings.MealSuggestionsLookbackWeeks;
        }
    }

    private async Task OnMealSuggestionsLookbackWeeksChangedAsync()
    {
        try
        {
            _preferencesError = null;
            _userSettings.MealSuggestionsLookbackWeeks = _mealSuggestionsLookbackWeeks;
            await DataService.SaveUserSettingsAsync(_userSettings);
            Snackbar.Add(
                $"Saved meal suggestions prompt lookback to {GetMealSuggestionsLookbackLabel(_mealSuggestionsLookbackWeeks).ToLowerInvariant()}.",
                Severity.Success
            );
        }
        catch (Exception ex)
        {
            _preferencesError = ex.Message;
            Snackbar.Add($"Couldn't save settings: {ex.Message}", Severity.Error);
            await RefreshUserSettingsAsync();
        }
    }

    private Task OnStartWithWindowsToggled()
    {
        try
        {
            _startupError = null;
            if (_startWithWindows)
                AutoStartService.Enable();
            else
                AutoStartService.Disable();

            _startWithWindows = AutoStartService.IsEnabled();
            Snackbar.Add(
                _startWithWindows ? "Enabled Windows startup." : "Disabled Windows startup.",
                Severity.Success
            );
        }
        catch (Exception ex)
        {
            _startupError = ex.Message;
            Snackbar.Add($"Couldn't update Windows startup: {ex.Message}", Severity.Error);
            RefreshStartupState();
        }

        return Task.CompletedTask;
    }

    private static string GetMealSuggestionsLookbackLabel(int weeks)
    {
        return weeks == 1 ? "1 week" : $"{weeks} weeks";
    }
}
